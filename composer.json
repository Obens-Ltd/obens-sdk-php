{
  "name": "obens/obens-sdk",
  "description": "SDK for the Obens integration API: push farmers, facilities and partners under your own ids",
  "type": "library",
  "license": "MIT",
  "version": "0.1.3",
  "homepage": "https://github.com/Obens-Ltd/obens-sdk-php",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5"
  },
  "autoload": {
    "psr-4": { "Obens\\Sdk\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Obens\\Sdk\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  }
}
